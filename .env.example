# ===== HELLS UP — переменные окружения =====
# Скопируйте в .env.local (локально) или добавьте в Vercel → Settings → Environment Variables.
# НИКОГДА не коммитьте реальные значения.

# --- Supabase (Project Settings → API) ---
# Публичные (допустимо в браузере): URL и anon-ключ. Используются только для Realtime (чтение публичных данных).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# СЕКРЕТ. Только сервер. service_role ключ — полный доступ к БД.
SUPABASE_SERVICE_ROLE_KEY=
# Необязательно. Legacy JWT secret проекта — нужен, чтобы выдавать клиенту токен для приватного Realtime чата поддержки.
# Если не задан — чат работает через опрос (polling).
SUPABASE_JWT_SECRET=

# --- Telegram ---
# СЕКРЕТ. Токен бота от @BotFather. Используется для проверки подписи initData.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (для ссылок, необязательно)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Максимальный возраст initData в секундах (по умолчанию 3600)
TELEGRAM_INITDATA_MAX_AGE=3600

# --- Сессии ---
# СЕКРЕТ. Случайная строка 32+ символов: openssl rand -base64 48
SESSION_SECRET=

# --- Администраторы ---
# СЕКРЕТ-список. Telegram ID администраторов через запятую, например 123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Локальная разработка ---
# demo-вход без Telegram. Работает ТОЛЬКО при `next dev`; в production (next start / Vercel) игнорируется.
DEMO_MODE=false
